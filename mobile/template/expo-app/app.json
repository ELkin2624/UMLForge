{
  "expo": {
    "name": "UMLForge Mobile Shell",
    "slug": "umlforge-mobile-shell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "umlforge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router"
    ]
  }
}
