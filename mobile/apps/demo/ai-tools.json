{
  "schema_version": "1.0",
  "project_name": "demo",
  "domain": "GENERIC",
  "tools": [
    {
      "name": "list_classs",
      "description": "Obtiene la lista de Classs registrados con filtros opcionales.",
      "method": "GET",
      "path": "/api/classs",
      "required_permission": "READ_CLASS",
      "http": {
        "method": "GET",
        "path": "/api/classs"
      },
      "permissions": {
        "required": "READ_CLASS"
      },
      "policy": {
        "action_type": "READ",
        "requires_confirmation": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Número máximo de registros a retornar"
          },
          "search": {
            "type": "string",
            "description": "Término de búsqueda textual"
          },
          "+ attribute": {
            "type": "string",
            "description": "Filtrar por + attribute"
          }
        },
        "required": []
      }
    },
    {
      "name": "get_class_by_id",
      "description": "Obtiene los detalles de un/a Class por su identificador único (ID).",
      "method": "GET",
      "path": "/api/classs/{id}",
      "required_permission": "READ_CLASS",
      "http": {
        "method": "GET",
        "path": "/api/classs/{id}"
      },
      "permissions": {
        "required": "READ_CLASS"
      },
      "policy": {
        "action_type": "READ",
        "requires_confirmation": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador de Class"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "create_class",
      "description": "Crea un/a nuevo/a Class en el sistema.",
      "method": "POST",
      "path": "/api/classs",
      "required_permission": "CREATE_CLASS",
      "http": {
        "method": "POST",
        "path": "/api/classs"
      },
      "permissions": {
        "required": "CREATE_CLASS"
      },
      "policy": {
        "action_type": "CREATE",
        "requires_confirmation": true
      },
      "parameters": {
        "type": "object",
        "properties": {
          "+ attribute": {
            "type": "string",
            "description": "Valor para + attribute"
          }
        },
        "required": []
      }
    },
    {
      "name": "update_class",
      "description": "Actualiza los datos de un/a Class existente.",
      "method": "PUT",
      "path": "/api/classs/{id}",
      "required_permission": "UPDATE_CLASS",
      "http": {
        "method": "PUT",
        "path": "/api/classs/{id}"
      },
      "permissions": {
        "required": "UPDATE_CLASS"
      },
      "policy": {
        "action_type": "UPDATE",
        "requires_confirmation": true
      },
      "parameters": {
        "type": "object",
        "properties": {
          "+ attribute": {
            "type": "string",
            "description": "Valor para + attribute"
          },
          "id": {
            "type": "integer",
            "description": "ID del/la Class a actualizar"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "delete_class",
      "description": "Elimina un/a Class por su ID.",
      "method": "DELETE",
      "path": "/api/classs/{id}",
      "required_permission": "DELETE_CLASS",
      "http": {
        "method": "DELETE",
        "path": "/api/classs/{id}"
      },
      "permissions": {
        "required": "DELETE_CLASS"
      },
      "policy": {
        "action_type": "DELETE",
        "requires_confirmation": true
      },
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID del/la Class a eliminar"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ]
}