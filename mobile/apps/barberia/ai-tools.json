{
  "schema_version": "1.0",
  "project_name": "barberia",
  "domain": "E_COMMERCE",
  "tools": [
    {
      "name": "list_clientes",
      "description": "Obtiene la lista de Clientes registrados con filtros opcionales.",
      "method": "GET",
      "path": "/api/clientes",
      "required_permission": "READ_CLIENTE",
      "http": {
        "method": "GET",
        "path": "/api/clientes"
      },
      "permissions": {
        "required": "READ_CLIENTE"
      },
      "policy": {
        "action_type": "READ",
        "requires_confirmation": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Número máximo de registros a retornar"
          },
          "search": {
            "type": "string",
            "description": "Término de búsqueda textual"
          },
          "nombre": {
            "type": "string",
            "description": "Filtrar por nombre"
          }
        },
        "required": []
      }
    },
    {
      "name": "get_cliente_by_id",
      "description": "Obtiene los detalles de un/a Cliente por su identificador único (ID).",
      "method": "GET",
      "path": "/api/clientes/{id}",
      "required_permission": "READ_CLIENTE",
      "http": {
        "method": "GET",
        "path": "/api/clientes/{id}"
      },
      "permissions": {
        "required": "READ_CLIENTE"
      },
      "policy": {
        "action_type": "READ",
        "requires_confirmation": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador de Cliente"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "create_cliente",
      "description": "Crea un/a nuevo/a Cliente en el sistema.",
      "method": "POST",
      "path": "/api/clientes",
      "required_permission": "CREATE_CLIENTE",
      "http": {
        "method": "POST",
        "path": "/api/clientes"
      },
      "permissions": {
        "required": "CREATE_CLIENTE"
      },
      "policy": {
        "action_type": "CREATE",
        "requires_confirmation": true
      },
      "parameters": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Valor para nombre"
          }
        },
        "required": []
      }
    },
    {
      "name": "update_cliente",
      "description": "Actualiza los datos de un/a Cliente existente.",
      "method": "PUT",
      "path": "/api/clientes/{id}",
      "required_permission": "UPDATE_CLIENTE",
      "http": {
        "method": "PUT",
        "path": "/api/clientes/{id}"
      },
      "permissions": {
        "required": "UPDATE_CLIENTE"
      },
      "policy": {
        "action_type": "UPDATE",
        "requires_confirmation": true
      },
      "parameters": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Valor para nombre"
          },
          "id": {
            "type": "integer",
            "description": "ID del/la Cliente a actualizar"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "delete_cliente",
      "description": "Elimina un/a Cliente por su ID.",
      "method": "DELETE",
      "path": "/api/clientes/{id}",
      "required_permission": "DELETE_CLIENTE",
      "http": {
        "method": "DELETE",
        "path": "/api/clientes/{id}"
      },
      "permissions": {
        "required": "DELETE_CLIENTE"
      },
      "policy": {
        "action_type": "DELETE",
        "requires_confirmation": true
      },
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID del/la Cliente a eliminar"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ]
}