# Copia a `.env` solo si quieres cambiar algo. Todos los valores tienen un valor por defecto.

# Modelo(s) a descargar; varios separados por espacio: "qwen3.5:4b qwen3.5:9b"
# 4b (~4 GB): recomendado para 16 GB sin GPU. 9b (~7 GB): mejor calidad, bastante más lento en CPU.
OLLAMA_MODEL=qwen3.5:4b

# Contexto máximo en tokens. Súbelo solo si te sobra RAM.
OLLAMA_CONTEXT_LENGTH=8192

# Dirección en la que se publica el puerto.
#   127.0.0.1      -> solo esta máquina (por defecto, lo más seguro)
#   100.x.y.z      -> la IP de Tailscale de esta máquina: accesible desde tus otros equipos
#   0.0.0.0        -> toda la red local (solo si confías en ella: Ollama no tiene autenticación)
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434

# Tiempo que el modelo permanece en memoria sin uso.
OLLAMA_KEEP_ALIVE=30m

# Versión de la imagen. Qwen3.5 necesita un Ollama reciente: si falla la descarga, deja `latest`.
OLLAMA_VERSION=latest
