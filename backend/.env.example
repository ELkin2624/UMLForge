MAX_UPLOAD_SIZE=10485760
CORS_ORIGINS=["*"]

# Database configuration
POSTGRES_USER=umlforge
POSTGRES_PASSWORD=umlforge_password
POSTGRES_DB=umlforge
POSTGRES_HOST=localhost
# El docker-compose publica Postgres en 5437 (-> 5432 del contenedor)
POSTGRES_PORT=5437
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# JWT & Auth
JWT_SECRET=super_secret_key_change_in_production
JWT_ACCESS_EXPIRES=15
JWT_REFRESH_EXPIRES=10080

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Providers
# gemini (nube) u ollama (modelo local). Para Ollama, deja GEMINI_API_KEY vacía.
AI_PROVIDER=gemini
GEMINI_API_KEY=""
COHERE_API_KEY=""
# Ollama local: el backend se comunica con este servidor, no el navegador ni el móvil.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=180
# Solo para un proxy remoto temporal protegido; no subir el valor real al repositorio.
OLLAMA_API_TOKEN=""

# MongoDB (diagramas, versiones y memoria de la IA)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=umlforge_ai
