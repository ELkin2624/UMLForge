	<packagedElement xmi:type="uml:Package" name="3.3.1 Arquitectura de Analisis (Ciclo #2)" xmi:id="EAPK_ANL00001_0001_4000_8000_000000000001" visibility="public">

			
			
			
			<packagedElement xmi:type="uml:Package" name="1. Descripcion de Paquetes de Analisis" xmi:id="EAPK_ANL00002_0001_4000_8000_000000000001" visibility="public">
				
				<packagedElement xmi:type="uml:Package" name="Autenticacion y Accesos" xmi:id="EAID_P1_AUTH" visibility="public" />
				<packagedElement xmi:type="uml:Package" name="Gestion de Proyectos y Versiones (NoSQL)" xmi:id="EAID_P1_PROJ" visibility="public" />
				<packagedElement xmi:type="uml:Package" name="Modelado Visual y Colaborativo" xmi:id="EAID_P1_VISUAL" visibility="public" />
				<packagedElement xmi:type="uml:Package" name="Agente IA Co-Desarrollador" xmi:id="EAID_P1_AI" visibility="public" />
				<packagedElement xmi:type="uml:Package" name="Diseno y Normalizacion de Datos" xmi:id="EAID_P1_DATA" visibility="public" />
				<packagedElement xmi:type="uml:Package" name="Motor MDD - Generador" xmi:id="EAID_P1_MDD" visibility="public" />
				<packagedElement xmi:type="uml:Package" name="Supervision Movil" xmi:id="EAID_P1_MOBILE" visibility="public" />

				
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_NOTE_AUTH" name="Nota Autenticacion" body="Gestiona identificacion y control de acceso al sistema. Permite registrarse, autenticarse y mantener sesiones seguras mediante JWT con roles OWNER, EDITOR y READER.">
					<annotatedElement xmi:idref="EAID_P1_AUTH" />
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_NOTE_PROJ" name="Nota Proyectos NoSQL" body="Administra repositorios de trabajo. Persiste proyectos en PostgreSQL y control documental en MongoDB: historial inmutable de versiones, auditoria y memoria de decisiones compartidas.">
					<annotatedElement xmi:idref="EAID_P1_PROJ" />
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_NOTE_VISUAL" name="Nota Modelado Visual" body="Nucleo del lienzo UML (Apollon/React Flow). Gestiona colaboracion en tiempo real con WebSockets y Yjs, presencia visual de IA (cursor violeta) y aplicacion transaccional de parches.">
					<annotatedElement xmi:idref="EAID_P1_VISUAL" />
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_NOTE_AI" name="Nota Agente IA" body="Integra el agente IA como copiloto. Razona sobre el modelo canonico, transcribe notas de voz con Whisper y soporta modo hibrido: Google AI Studio en la nube o LLM local con Ollama/Qwen.">
					<annotatedElement xmi:idref="EAID_P1_AI" />
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_NOTE_DATA" name="Nota Diseno Datos" body="Diseno logico de base de datos. Transforma clases UML a tablas relacionales, deduce dependencias funcionales y certifica normalizacion demostrable (1FN a FNBC) con sintesis de Bernstein.">
					<annotatedElement xmi:idref="EAID_P1_DATA" />
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_NOTE_MDD" name="Nota Motor MDD" body="Motor de transformacion MDD. Valida semantica UML 2.5 y genera codigo fuente empresarial Spring Boot 3 con JPA, esquema relacional PostgreSQL y suites de pruebas automatizadas en Postman.">
					<annotatedElement xmi:idref="EAID_P1_MDD" />
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_NOTE_MOBILE" name="Nota Supervision Movil" body="App movil en Expo SDK 58 / React Native (solo lectura). Permite explorar proyectos, inspeccionar diagramas UML con gestos tactiles, auditar historial de versiones y consultar a la IA.">
					<annotatedElement xmi:idref="EAID_P1_MOBILE" />
				</ownedComment>
			</packagedElement>

			
			
			
