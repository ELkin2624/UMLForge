			<element xmi:idref="EAID_NOTE_AUTH" xmi:type="uml:Comment" name="Nota Autenticacion" scope="public">
				<model package="EAPK_ANL00002_0001_4000_8000_000000000001" tpos="0" ea_localid="101" ea_eleType="element" />
				<properties isSpecification="false" sType="Note" nType="0" scope="public" />
				<documentation value="Gestiona identificacion y control de acceso al sistema. Permite registrarse, autenticarse y mantener sesiones seguras mediante JWT con roles OWNER, EDITOR y READER." />
			</element>
			<element xmi:idref="EAID_NOTE_PROJ" xmi:type="uml:Comment" name="Nota Proyectos NoSQL" scope="public">
				<model package="EAPK_ANL00002_0001_4000_8000_000000000001" tpos="0" ea_localid="102" ea_eleType="element" />
				<properties isSpecification="false" sType="Note" nType="0" scope="public" />
				<documentation value="Administra repositorios de trabajo. Persiste proyectos en PostgreSQL y control documental en MongoDB: historial inmutable de versiones, auditoria y memoria de decisiones compartidas." />
			</element>
			<element xmi:idref="EAID_NOTE_VISUAL" xmi:type="uml:Comment" name="Nota Modelado Visual" scope="public">
				<model package="EAPK_ANL00002_0001_4000_8000_000000000001" tpos="0" ea_localid="103" ea_eleType="element" />
				<properties isSpecification="false" sType="Note" nType="0" scope="public" />
				<documentation value="Nucleo del lienzo UML (Apollon/React Flow). Gestiona colaboracion en tiempo real con WebSockets y Yjs, presencia visual de IA (cursor violeta) y aplicacion transaccional de parches." />
			</element>
			<element xmi:idref="EAID_NOTE_AI" xmi:type="uml:Comment" name="Nota Agente IA" scope="public">
				<model package="EAPK_ANL00002_0001_4000_8000_000000000001" tpos="0" ea_localid="104" ea_eleType="element" />
				<properties isSpecification="false" sType="Note" nType="0" scope="public" />
				<documentation value="Integra el agente IA como copiloto. Razona sobre el modelo canonico, transcribe notas de voz con Whisper y soporta modo hibrido: Google AI Studio en la nube o LLM local con Ollama/Qwen." />
			</element>
			<element xmi:idref="EAID_NOTE_DATA" xmi:type="uml:Comment" name="Nota Diseno Datos" scope="public">
				<model package="EAPK_ANL00002_0001_4000_8000_000000000001" tpos="0" ea_localid="105" ea_eleType="element" />
				<properties isSpecification="false" sType="Note" nType="0" scope="public" />
				<documentation value="Diseno logico de base de datos. Transforma clases UML a tablas relacionales, deduce dependencias funcionales y certifica normalizacion demostrable (1FN a FNBC) con sintesis de Bernstein." />
			</element>
			<element xmi:idref="EAID_NOTE_MDD" xmi:type="uml:Comment" name="Nota Motor MDD" scope="public">
				<model package="EAPK_ANL00002_0001_4000_8000_000000000001" tpos="0" ea_localid="106" ea_eleType="element" />
				<properties isSpecification="false" sType="Note" nType="0" scope="public" />
				<documentation value="Motor de transformacion MDD. Valida semantica UML 2.5 y genera codigo fuente empresarial Spring Boot 3 con JPA, esquema relacional PostgreSQL y suites de pruebas automatizadas en Postman." />
			</element>
			<element xmi:idref="EAID_NOTE_MOBILE" xmi:type="uml:Comment" name="Nota Supervision Movil" scope="public">
				<model package="EAPK_ANL00002_0001_4000_8000_000000000001" tpos="0" ea_localid="107" ea_eleType="element" />
				<properties isSpecification="false" sType="Note" nType="0" scope="public" />
				<documentation value="App movil en Expo SDK 58 / React Native (solo lectura). Permite explorar proyectos, inspeccionar diagramas UML con gestos tactiles, auditar historial de versiones y consultar a la IA." />
			</element>

			
